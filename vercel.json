{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/projects/acuivect/simulator",
      "destination": "/projects/acuivect/simulator/",
      "permanent": true
    },
    {
      "source": "/projects/acuivect",
      "destination": "/projects/acuivect/",
      "permanent": true
    },
    {
      "source": "/projects/bitzy-v1",
      "destination": "/projects/bitzy-v1/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/projects/acuivect/simulator/",
      "destination": "/projects/acuivect/simulator/index.html"
    },
    {
      "source": "/projects/acuivect/",
      "destination": "/projects/acuivect/index.html"
    },
    {
      "source": "/projects/bitzy-v1/",
      "destination": "/projects/bitzy-v1/index.html"
    },
    {
      "source": "/((?!api/|projects/acuivect/|projects/bitzy-v1/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/chat.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/projects/acuivect/simulator/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/projects/acuivect/simulator/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/projects/acuivect/simulator/model/geometry-:part.gzpart",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
