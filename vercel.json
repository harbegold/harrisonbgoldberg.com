{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    { "source": "/projects/acuivect", "destination": "/projects/acuivect/", "permanent": true },
    { "source": "/projects/bitzy-v1", "destination": "/projects/bitzy-v1/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/projects/acuivect/", "destination": "/projects/acuivect/index.html" },
    { "source": "/projects/bitzy-v1/", "destination": "/projects/bitzy-v1/index.html" },
    { "source": "/((?!api/|projects/acuivect/|projects/bitzy-v1/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/chat.ts": {
      "maxDuration": 30
    }
  }
}
